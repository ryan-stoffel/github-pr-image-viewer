{
  "manifest_version": 3,
  "name": "GitHub PR Image Viewer",
  "version": "1.0.0",
  "description": "Opens images in GitHub pull requests in a zoomable popup with arrow-key navigation.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-pr-image-viewer@ryanstoffel",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
